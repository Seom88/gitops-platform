{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "baseBranchPatterns": ["dev"],
  "schedule": ["before 5am on monday"],
  "timezone": "Europe/Madrid",
  "labels": ["dependencies"],
  "ignorePaths": ["**/charts/*.tgz"],
  "minimumReleaseAge": "1 day",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Hardcoded k8s Job/CronJob images + app values image lines",
      "managerFilePatterns": ["/^platform\\/.*\\/templates\\/.*\\.yaml$/", "/^apps\\/.*\\/templates\\/.*\\.yaml$/", "/^apps\\/.*\\/values.*\\.yaml$/", "/^platform\\/.*\\/values.*\\.yaml$/"],
      "matchStrings": ["image:\\s*['\"]?(?<depName>[^:'\"\\s]+):(?<currentValue>[^@'\"\\s]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?['\"]?"],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Split repo:/tag: pairs (only pair in repo: Tailscale DNSConfig). Inline image: lines belong to Manager 1 — this manager intentionally has no inline matcher so a dep can never be extracted twice. Patterns must stay RE2-compatible: no lookahead, no backreferences (Renovate uses RE2).",
      "managerFilePatterns": ["/^platform\\/velero\\/values\\.yaml$/", "/^platform\\/velero\\/templates\\/.*\\.yaml$/", "/^platform\\/ts-operator\\/templates\\/.*\\.yaml$/"],
      "matchStrings": ["repo:\\s*['\"]?(?<depName>[^\\s'\";]+)['\"]?\\s*\\n\\s*tag:\\s*['\"]?(?<currentValue>[^'\"\\s]+)['\"]?"],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "HELM_VERSION env in workflows",
      "managerFilePatterns": ["/^\\.github\\/workflows\\/.*\\.ya?ml$/"],
      "matchStrings": ["HELM_VERSION:\\s*v(?<currentValue>[\\d.]+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "helm/helm"
    }
  ],
  "argocd": {
    "managerFilePatterns": ["/^gitops\\/templates\\/.*\\.ya?ml$/"]
  },
  "packageRules": [
    {
      "description": "Automerge patch+minor to dev (human promotes dev -> main after CI green)",
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Majors never automerge",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Never use a release less than 1 day old - global setting already enforces this, except pinDigest",
      "matchDatasources": ["docker"],
      "minimumReleaseAge": "1 day"
    },
    {
      "description": "Pin digests for all Docker images so tag bumps always refresh digests together",
      "matchDatasources": ["docker"],
      "pinDigests": true
    },
    {
      "description": "Images without digest support (CRD or chart without digest field) - tags only, digest tracked in comment where applicable",
      "matchPackageNames": ["tailscale/k8s-nameserver", "ghcr.io/immich-app/immich-server", "ghcr.io/immich-app/immich-machine-learning"],
      "pinDigests": false
    },
    {
      "description": "kubectl - group the 6 jobs, pin digest",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["bitnami/kubectl"],
      "groupName": "kubectl jobs",
      "groupSlug": "kubectl-jobs",
      "pinDigests": true
    },
    {
      "description": "Group Helm charts (vault, longhorn and cert-manager included — proven stable)",
      "matchDatasources": ["helm"],
      "groupName": "helm charts",
      "groupSlug": "helm-charts",
      "labels": ["helm"]
    },
    {
      "description": "Group GitHub Actions",
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "groupSlug": "github-actions",
      "labels": ["github-actions"]
    }
  ]
}
