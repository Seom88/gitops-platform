# ts operator secrets
K8S_TS_OAUTH_CLIENT_ID=...
K8S_TS_OAUTH_SECRET=...
# get state terraform from s3 bucket
S3_ENDPOINT=...
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
SOPS_AGE_KEY_FILE="/tmp/age-keys.txt"
# devcontainer
OPENROUTER_API_KEY=sk-or-...
GIT_USER_NAME=your_name
GIT_USER_EMAIL=your_email
# devcontainer kubeconfigs (host paths outside the repo; optional)
# Prod admin kubeconfig used to mint the read-only agent token:
DEVCONTAINER_PROD_ADMIN_KUBECONFIG=$HOME/.kube/prod-admin
# Optional: direct prod API server for the SA token. If unset and the admin
# kubeconfig uses the Tailscale API server proxy, the script auto-detects the
# control-plane Tailscale IP (requires the tailscale CLI on the host).
# DEVCONTAINER_API_SERVER=https://<control-plane-tailscale-ip>:6443
# Optional token TTL (default 24h):
# DEVCONTAINER_TOKEN_DURATION=24h
# Dev cluster kubeconfig, copied as-is with full access:
DEVCONTAINER_DEV_KUBECONFIG=$HOME/.kube/dev
# initializeCommand stages them in $HOME/.kube/devcontainer/{prod,dev}/kubeconfig
# and devcontainer.json mounts the prod and dev subdirectories read-only at /home/vscode/.kubeconfigs/{prod,dev}.
