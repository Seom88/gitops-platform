{
  "name": "homelab-devcontainer",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "containerUser": "agent",
  "remoteUser": "agent",
  "updateRemoteUserUID": false,
  "workspaceFolder": "/workspace",
  "workspaceMount": "type=bind,source=${localWorkspaceFolder},target=/workspace",
  "mounts": [
    "source=/dev/null,target=/workspace/.env,type=bind,readonly=true",
    "source=/dev/null,target=/workspace/kubeconfig,type=bind,readonly=true",
    "source=${localEnv:HOME}/.config/devcontainer/kubeconfig,target=/home/agent/.kube/config,type=bind,readonly=true"
  ],
  "remoteEnv": {
    "KUBECONFIG": "/home/agent/.kube/config",
    "PNPM_HOME": "/home/agent/.local/share/pnpm",
    "PATH": "/home/agent/.local/share/pnpm:${containerEnv:PATH}"
  },
  "features": {}
}
